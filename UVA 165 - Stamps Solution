const int MOD = 998244353;

// using namespace __gnu_pbds;
// typedef tree<int, null_type, int, rb_tree_tag,
//               tree_order_statistics_node_update>
//      oset;
vi vec;
std::vector<std::vector<int>> subs;
vi sums;
std::vector<std::vector<std::vector<int>>> ans;

void gen(int k, int idx, vi subset) {
    if (subset.size() == k) {
        subs.push_back(subset);
        return;
    }
    if (idx >= 32) return;

    gen(k, idx + 1, subset);

    subset.push_back(vec[idx]);
    gen(k, idx + 1, subset);
}

void gen2(int h, vi &subset, int sum) {
    if (sum >= 200) return;
    sums[sum] = 1;
    if (h == 0) return;

    for (int i = 0; i < subset.size(); i++) {
        gen2(h - 1, subset, sum + subset[i]);
    }
}

int main() {
    ans.assign(10, std::vector<std::vector<int>>(10));
    for (int i = 1; i < 33; ++i) {
        vec.push_back(i);
    }

    for (int i = 1; i <= 9; ++i) {
        vi sub{1};
        for (int j = 1; (j + i) <= 9; ++j) {
            subs.clear();
            gen(j, 0, sub);

            for (auto sb : subs) {
                sums.assign(200, 0);
                gen2(i, sb, 0);
                int mx = -1;

                for (auto j : sums) {
                    if (j == 0) break;
                    ++mx;
                }

                if (ans[i][j].empty() or mx > ans[i][j].back()) {
                    sb.push_back(mx);
                    ans[i][j] = sb;
                }
            }
        }
    }

    int h, k;
    while (std::cin >> h >> k && h && k) {
        for (int i = 0; i < ans[h][k].size() - 1; ++i) {
            printf("%3d", ans[h][k][i]);
        }printf(" ->%3d\n", ans[h][k].back());
    }
}



