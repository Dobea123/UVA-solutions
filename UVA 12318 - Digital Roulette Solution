long long mod(long long a, long long m) {
    return (a % m + m) % m;
}

long long modpow(long long b, long long p, long long m) {
    if (p == 0) return 1;
    long long ans = modpow(b, p / 2, m);
    ans = mod(ans * ans, m);
    if (p % 2 == 1) ans = mod(ans * b, m);
    return ans;
}

int main() {
    int n,m; while (std::cin >> n >> m && (n + m) != 0) {
        int k; std::cin >> k;
        std::vector<long long> vec(k + 1);

        for (int i = 0; i < k + 1; i++) {
            std::cin >> vec[i];
        }

        std::set<long long> sans;
        int N = n + 1;

        for (int i = 0; i <= m; ++i) {
            long long ans = 0;
            for (int j = 0; j < k + 1; ++j) {
                ans += vec[j] * modpow(i,j,N);
                ans %= N;
            }
            ans %= N;
            sans.insert(ans);
        }

        printf("%lld\n", sans.size());
    }
}




